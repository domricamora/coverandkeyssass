# Safety net for hosts where the document root cannot point at /public
# (shared cPanel, or this repo sitting under a WAMP/XAMPP web root).
# The correct setup is still: document root = <app>/public. With that, Apache
# never reads this file.

Options -Indexes

# On shared hosting this app can sit inside another site's folder (e.g. public_html/ck.deskpulse.click),
# whose .htaccess sets its own security headers with "Header always set"; those win over the headers
# PHP sends, and that site's CSP blocks Google Fonts and Alpine. Re-assert the app's own values here.
# ponytail: a copy of App\Http\Middleware\SecurityHeaders; keep both in step (or drop this block once the
# app has its own document root on the final host).
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://*.paymongo.com; frame-ancestors 'self'"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(self)"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Let AutoSSL / ACME domain validation through.
    RewriteRule ^\.well-known/ - [L]

    # Never serve anything outside public/: dotfiles (.env, .git), source,
    # config, logs, dependencies, tooling.
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(app|bootstrap|config|database|docs|lang|node_modules|resources|routes|storage|tests|vendor|_ai)(/|$) - [F,L,NC]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|tailwind\.config\.js|postcss\.config\.js|.*\.md)$ - [F,L,NC]

    # Everything else is served from public/.
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    # Without mod_rewrite, refuse everything rather than expose the app.
    Require all denied
</IfModule>
