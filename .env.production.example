# Production template (Phase 35). Copy to .env on the server and fill every
# blank. Never commit the real .env. See docs/DEPLOYMENT.md.

APP_NAME="Cover & Keys"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-domain.com
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Redis when the host provides it (cPanel: "Redis" in Software, or a VPS).
# Without Redis, use: CACHE_STORE=database, SESSION_DRIVER=database, QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE defaults to true in production; leave unset.

# Real SMTP (cPanel mail or a provider). Password-reset and guest emails depend on it.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=bookings@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# PayMongo live keys + the secret of the webhook you register in the dashboard.
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=live
PAYMONGO_METHODS=card,gcash,paymaya

# Marketplace commission (%) when no rule matches; Super Admin settings override it.
COMMISSION_DEFAULT_RATE=10

# API tokens expire after 30 days (minutes).
SANCTUM_EXPIRATION=43200

# Backups (docs/BACKUPS.md). Set an off-site disk and keep the password off the server.
BACKUP_KEEP=14
BACKUP_OFFSITE_DISK=
BACKUP_PASSWORD=
BACKUP_VERIFY_DATABASE=

PERF_TRACE=false

# SMS (log | semaphore | twilio). Semaphore is the usual PH gateway.
SMS_DRIVER=log
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
